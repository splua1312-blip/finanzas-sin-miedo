# Clave de la API de Anthropic (obligatoria para la capacidad de IA).
# Obtén una en https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Modelo de Claude a usar (opcional). Por defecto: claude-sonnet-5-5.
# Puedes subirlo a claude-opus-5-5 para mayor calidad a mayor costo.
ANTHROPIC_MODEL=claude-sonnet-5-5
