# ============================================================================
# IA — Anthropic (Claude)
# ============================================================================
# Clave de la API de Anthropic (obligatoria para la capacidad de IA).
# Obtén una en https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Modelo de Claude a usar (opcional). Por defecto: claude-sonnet-5-5.
# Puedes subirlo a claude-opus-5-5 para mayor calidad a mayor costo.
ANTHROPIC_MODEL=claude-sonnet-5-5

# ============================================================================
# Autenticación y base de datos — Supabase
# ============================================================================
# Panel: https://supabase.com/ > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clave service_role (SECRETA, solo servidor; la usa el webhook de Stripe).
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# Pagos — Stripe
# ============================================================================
# Panel: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# ID del precio (Price) del plan Pro mensual (empieza con "price_").
STRIPE_PRICE_ID=
# Secreto de firma del webhook (empieza con "whsec_"). Ver README.
STRIPE_WEBHOOK_SECRET=

# ============================================================================
# URL pública de la app (opcional pero recomendada en producción)
# ============================================================================
# Se usa para las URLs de éxito/cancelación de Stripe. Ej: https://tu-sitio.netlify.app
NEXT_PUBLIC_APP_URL=
